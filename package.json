{
  "name": "booking-qa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end QA automation for a booking app: Playwright (UI + API), accessibility checks, JMeter load tests and CI.",
  "scripts": {
    "start": "node app/server.js",
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=mobile",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:a11y": "playwright test --grep @a11y",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "perf": "bash scripts/run-jmeter.sh",
    "perf:check": "node scripts/check-jmeter-results.js performance/results/results.jtl"
  },
  "dependencies": {
    "express": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  },
  "author": "Axil Patel",
  "license": "MIT"
}
